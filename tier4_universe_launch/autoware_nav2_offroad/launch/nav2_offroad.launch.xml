<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="mode_manager_prefix" default="/nav2_offroad/mode_manager" description="prefix for trajectory_mode_manager topics/services"/>
  <!-- Off-road selection is handled by autoware_scenario_selector (OFFROAD scenario).
       Set true only for the legacy standalone mux path (also set the planning_validator
       output to /planning/trajectory_pre_mux). -->
  <arg name="launch_trajectory_mode_manager" default="false"/>
  <arg name="nav2_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/nav2_offroad.param.yaml"/>
  <arg name="bridge_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/nav2_path_to_trajectory_bridge.param.yaml"/>
  <arg name="free_map_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/free_map_publisher.param.yaml"/>
  <arg name="relay_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/perception_occupancy_relay.param.yaml"/>
  <arg name="launch_return_home" default="true"/>
  <arg name="return_home_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/return_home.param.yaml"/>

  <!-- Source of the occupancy grid that feeds the Nav2 costmap:
         free       -> free_map_publisher (all-free map, for sim / open ground)
         perception -> relay the real Autoware perception occupancy grid
         slam       -> relay the SLAM map (/map) as the costmap input -->
  <arg name="occupancy_grid_source" default="free" description="free | perception | slam"/>
  <arg name="costmap_occupancy_topic" default="/nav2_offroad/costmap/occupancy_grid"/>
  <arg name="perception_occupancy_topic" default="/perception/occupancy_grid_map/map"/>
  <arg name="slam_relay_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/slam_map_relay.param.yaml"/>

  <!-- Off-road local control layer:
         bridge -> path is converted to an Autoware Trajectory and driven by the
                   Autoware trajectory_follower (default, unchanged).
         mppi   -> Nav2 controller_server (nav2_mppi_controller) drives the path and
                   emits /cmd_vel; bt_navigator orchestrates planner->controller.
                   The goal relay and cmd_vel->Control bridge below make this mode
                   drivable when `auto_control_cmd_topic` is set to
                   /nav2_offroad/mppi/control_cmd at the top level (see Task 4). -->
  <arg name="local_layer" default="bridge" description="bridge | mppi | mppi_recovery (mppi_recovery = EXPERIMENTAL: mppi + behavior_server + recovery BTs + loosened planner)"/>
  <!-- Global planner A/B (BACKLOG #11): smac_hybrid (default) | lattice. -->
  <arg name="global_planner" default="smac_hybrid" description="smac_hybrid | lattice"/>
  <arg name="mppi_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/nav2_mppi_controller.param.yaml"/>
  <arg name="bt_nav_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/nav2_bt_navigator.param.yaml"/>
  <arg name="lattice_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/nav2_smac_lattice.param.yaml"/>
  <arg name="vehicle_wheelbase_m" default="2.7"/>
  <arg name="cmd_vel_bridge_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/cmd_vel_to_control.param.yaml"/>

  <!-- lifecycle node list depends on the local layer -->
  <let name="lifecycle_nodes" value="[planner_server, smoother_server]"
       unless="$(eval '&quot;$(var local_layer)&quot; in [&quot;mppi&quot;,&quot;mppi_recovery&quot;]')"/>
  <let name="lifecycle_nodes" value="[planner_server, smoother_server, controller_server, bt_navigator]"
       if="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi&quot;')"/>
  <let name="lifecycle_nodes" value="[planner_server, smoother_server, controller_server, bt_navigator, behavior_server]"
       if="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>

  <!-- mppi_recovery selects recovery BTs + a loosened Hybrid tolerance; mppi keeps the
       recovery-free BTs and stock tolerance. (launch_xml forbids conditional <param>, so
       select via <let>.) -->
  <let name="bt_to_pose_xml"
       value="$(find-pkg-share autoware_nav2_offroad)/config/behavior_trees/navigate_to_pose_no_recovery.xml"
       unless="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="bt_to_pose_xml"
       value="$(find-pkg-share autoware_nav2_offroad)/config/behavior_trees/navigate_to_pose_recovery_offroad.xml"
       if="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="bt_through_poses_xml"
       value="$(find-pkg-share autoware_nav2_offroad)/config/behavior_trees/navigate_through_poses_no_recovery.xml"
       unless="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="bt_through_poses_xml"
       value="$(find-pkg-share autoware_nav2_offroad)/config/behavior_trees/navigate_through_poses_recovery_offroad.xml"
       if="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="planner_goal_tol" value="0.25"
       unless="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="planner_goal_tol" value="0.5"
       if="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="planner_approach_iters" value="1000"
       unless="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="planner_approach_iters" value="8000"
       if="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <!-- mppi_recovery loosens the goal checker so a forward-only vehicle that overshoots by a
       little still registers "reached" instead of looping; yaw is ignored (position goal). -->
  <let name="goal_xy_tol" value="0.5"
       unless="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="goal_xy_tol" value="1.5"
       if="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="goal_yaw_tol" value="0.25"
       unless="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>
  <let name="goal_yaw_tol" value="3.15"
       if="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')"/>

  <node pkg="autoware_nav2_offroad" exec="free_map_publisher_node" name="free_map_publisher" output="screen"
        if="$(eval '&quot;$(var occupancy_grid_source)&quot;==&quot;free&quot;')">
    <param from="$(var free_map_param_file)"/>
    <param name="output_topic" value="$(var costmap_occupancy_topic)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="autoware_nav2_offroad" exec="perception_occupancy_relay_node" name="perception_occupancy_relay" output="screen"
        if="$(eval '&quot;$(var occupancy_grid_source)&quot;==&quot;perception&quot;')">
    <param from="$(var relay_param_file)"/>
    <param name="input_topic" value="$(var perception_occupancy_topic)"/>
    <param name="output_topic" value="$(var costmap_occupancy_topic)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="autoware_nav2_offroad" exec="perception_occupancy_relay_node" name="slam_map_relay" output="screen"
        if="$(eval '&quot;$(var occupancy_grid_source)&quot;==&quot;slam&quot;')">
    <param from="$(var slam_relay_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- NOTE: split into two node entries (rather than a conditional <param if=.../> on a
       single node) because ROS 2 Humble's launch_xml frontend does not support if/unless
       attributes on <param> elements — only on <node>/<group>/<let>. Pre-existing bug fixed
       incidentally here because it blocked launch-file parsing in both local_layer modes. -->
  <node pkg="nav2_planner" exec="planner_server" name="planner_server" output="screen"
        unless="$(eval '&quot;$(var global_planner)&quot;==&quot;lattice&quot;')">
    <param from="$(var nav2_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="global_costmap.global_costmap.use_sim_time" value="$(var use_sim_time)"/>
    <!-- mppi_recovery loosens the goal tolerance so exact-pose parking isn't demanded. -->
    <param name="GridBased.tolerance" value="$(var planner_goal_tol)"/>
    <param name="GridBased.max_on_approach_iterations" value="$(var planner_approach_iters)"/>
  </node>

  <!-- global_planner:=lattice overlays SmacPlannerLattice over the Hybrid block above
       (base file still provides global_costmap). -->
  <node pkg="nav2_planner" exec="planner_server" name="planner_server" output="screen"
        if="$(eval '&quot;$(var global_planner)&quot;==&quot;lattice&quot;')">
    <param from="$(var nav2_param_file)"/>
    <param from="$(var lattice_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="global_costmap.global_costmap.use_sim_time" value="$(var use_sim_time)"/>
    <!-- mppi_recovery loosens the goal tolerance so exact-pose parking isn't demanded. -->
    <param name="GridBased.tolerance" value="$(var planner_goal_tol)"/>
    <param name="GridBased.max_on_approach_iterations" value="$(var planner_approach_iters)"/>
  </node>

  <node pkg="nav2_smoother" exec="smoother_server" name="smoother_server" output="screen">
    <param from="$(var nav2_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_navigation" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="autostart" value="true"/>
    <param name="node_names" value="$(var lifecycle_nodes)"/>
  </node>

  <node pkg="autoware_nav2_offroad" exec="nav2_path_to_trajectory_bridge_node" name="nav2_path_to_trajectory_bridge" output="screen"
        if="$(eval '&quot;$(var local_layer)&quot;==&quot;bridge&quot;')">
    <param from="$(var bridge_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- MPPI local layer (local_layer:=mppi). BACKLOG #11. -->
  <node pkg="nav2_controller" exec="controller_server" name="controller_server" output="screen"
        if="$(eval '&quot;$(var local_layer)&quot; in [&quot;mppi&quot;,&quot;mppi_recovery&quot;]')">
    <param from="$(var mppi_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="local_costmap.local_costmap.use_sim_time" value="$(var use_sim_time)"/>
    <!-- goal-checker tolerance: config default for mppi; loosened for mppi_recovery (see lets). -->
    <param name="goal_checker.xy_goal_tolerance" value="$(var goal_xy_tol)"/>
    <param name="goal_checker.yaw_goal_tolerance" value="$(var goal_yaw_tol)"/>
  </node>

  <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator" output="screen"
        if="$(eval '&quot;$(var local_layer)&quot; in [&quot;mppi&quot;,&quot;mppi_recovery&quot;]')">
    <param from="$(var bt_nav_param_file)"/>
    <!-- BT selection is mode-dependent (see the bt_*_xml lets above): mppi uses the
         recovery-free BTs (no behavior_server); mppi_recovery uses the recovery BTs that
         call behavior_server. bt_navigator (Humble) instantiates BOTH navigators regardless
         of the `navigators` list, so both defaults are set. -->
    <param name="default_nav_to_pose_bt_xml" value="$(var bt_to_pose_xml)"/>
    <param name="default_nav_through_poses_bt_xml" value="$(var bt_through_poses_xml)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- mppi_recovery only: recovery action servers (wait, drive_on_heading) for the recovery BTs. -->
  <node pkg="nav2_behaviors" exec="behavior_server" name="behavior_server" output="screen"
        if="$(eval '&quot;$(var local_layer)&quot;==&quot;mppi_recovery&quot;')">
    <param from="$(find-pkg-share autoware_nav2_offroad)/config/nav2_behavior_server.param.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- mppi mode: goal topic -> NavigateToPose action (latest goal wins; cancel reuses offroad_cancel) -->
  <node pkg="autoware_nav2_offroad" exec="offroad_goal_relay_node" name="offroad_goal_relay" output="screen"
        if="$(eval '&quot;$(var local_layer)&quot; in [&quot;mppi&quot;,&quot;mppi_recovery&quot;]')">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="~/input/goal" to="/planning/offroad_goal"/>
    <remap from="~/input/cancel" to="/planning/offroad_cancel"/>
  </node>

  <!-- mppi mode: /cmd_vel -> Control on the gate AUTO input (see auto_control_cmd_topic in control launch).
       NOTE: pair local_layer:=mppi with auto_control_cmd_topic:=/nav2_offroad/mppi/control_cmd at the top level. -->
  <node pkg="autoware_nav2_offroad" exec="cmd_vel_to_control_bridge_node" name="cmd_vel_to_control_bridge" output="screen"
        if="$(eval '&quot;$(var local_layer)&quot; in [&quot;mppi&quot;,&quot;mppi_recovery&quot;]')">
    <param from="$(var cmd_vel_bridge_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="wheelbase_m" value="$(var vehicle_wheelbase_m)"/>
    <param name="initial_enabled" value="true"/>
    <remap from="~/input/cmd_vel" to="/cmd_vel"/>
    <remap from="~/output/control_cmd" to="/nav2_offroad/mppi/control_cmd"/>
    <remap from="~/output/gear_cmd" to="/planning/gear_cmd"/>
  </node>

  <node pkg="autoware_nav2_offroad" exec="return_home_node" name="return_home" output="screen"
        if="$(var launch_return_home)">
    <param from="$(var return_home_param_file)"/>
    <remap from="~/input/kinematic_state" to="/localization/kinematic_state"/>
  </node>

  <node pkg="autoware_nav2_offroad" exec="trajectory_mode_manager_node" name="trajectory_mode_manager" output="screen"
        if="$(var launch_trajectory_mode_manager)">
    <remap from="input/onroad/trajectory"  to="/planning/trajectory_pre_mux"/>
    <remap from="input/offroad/trajectory" to="/nav2_offroad/planning/trajectory"/>
    <remap from="output/trajectory"        to="/planning/trajectory"/>
    <remap from="~/status"                 to="$(var mode_manager_prefix)/status"/>
    <remap from="~/debug"                  to="$(var mode_manager_prefix)/debug"/>
    <remap from="~/events"                 to="$(var mode_manager_prefix)/events"/>
    <remap from="~/markers"                to="$(var mode_manager_prefix)/markers"/>
    <remap from="~/change_mode"            to="$(var mode_manager_prefix)/change_mode"/>
    <param name="lifecycle_manager_service" value="/lifecycle_manager_navigation/manage_nodes"/>
    <!-- Nav2 is kept hot by lifecycle_manager autostart for now; set true to let
         the manager deactivate Nav2 on-demand in on-road mode (see MODE_MANAGER_DESIGN.md). -->
    <param name="manage_nav2_lifecycle" value="false"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
