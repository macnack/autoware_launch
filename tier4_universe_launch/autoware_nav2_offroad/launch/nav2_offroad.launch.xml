<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="mode_manager_prefix" default="/nav2_offroad/mode_manager" description="prefix for trajectory_mode_manager topics/services"/>
  <arg name="nav2_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/nav2_offroad.param.yaml"/>
  <arg name="bridge_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/nav2_path_to_trajectory_bridge.param.yaml"/>
  <arg name="free_map_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/free_map_publisher.param.yaml"/>
  <arg name="relay_param_file" default="$(find-pkg-share autoware_nav2_offroad)/config/perception_occupancy_relay.param.yaml"/>

  <!-- Source of the occupancy grid that feeds the Nav2 costmap:
         free       -> free_map_publisher (all-free map, for sim / open ground)
         perception -> relay the real Autoware perception occupancy grid -->
  <arg name="occupancy_grid_source" default="free" description="free | perception"/>
  <arg name="costmap_occupancy_topic" default="/nav2_offroad/costmap/occupancy_grid"/>
  <arg name="perception_occupancy_topic" default="/perception/occupancy_grid_map/map"/>

  <node pkg="autoware_nav2_offroad" exec="free_map_publisher_node" name="free_map_publisher" output="screen"
        if="$(eval '&quot;$(var occupancy_grid_source)&quot;==&quot;free&quot;')">
    <param from="$(var free_map_param_file)"/>
    <param name="output_topic" value="$(var costmap_occupancy_topic)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="autoware_nav2_offroad" exec="perception_occupancy_relay_node" name="perception_occupancy_relay" output="screen"
        if="$(eval '&quot;$(var occupancy_grid_source)&quot;==&quot;perception&quot;')">
    <param from="$(var relay_param_file)"/>
    <param name="input_topic" value="$(var perception_occupancy_topic)"/>
    <param name="output_topic" value="$(var costmap_occupancy_topic)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="nav2_planner" exec="planner_server" name="planner_server" output="screen">
    <param from="$(var nav2_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="global_costmap.global_costmap.use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="nav2_smoother" exec="smoother_server" name="smoother_server" output="screen">
    <param from="$(var nav2_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_navigation" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="autostart" value="true"/>
    <param name="node_names" value="[planner_server, smoother_server]"/>
  </node>

  <node pkg="autoware_nav2_offroad" exec="nav2_path_to_trajectory_bridge_node" name="nav2_path_to_trajectory_bridge" output="screen">
    <param from="$(var bridge_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="autoware_nav2_offroad" exec="trajectory_mode_manager_node" name="trajectory_mode_manager" output="screen">
    <remap from="input/onroad/trajectory"  to="/planning/trajectory_pre_mux"/>
    <remap from="input/offroad/trajectory" to="/nav2_offroad/planning/trajectory"/>
    <remap from="output/trajectory"        to="/planning/trajectory"/>
    <remap from="~/status"                 to="$(var mode_manager_prefix)/status"/>
    <remap from="~/debug"                  to="$(var mode_manager_prefix)/debug"/>
    <remap from="~/events"                 to="$(var mode_manager_prefix)/events"/>
    <remap from="~/markers"                to="$(var mode_manager_prefix)/markers"/>
    <remap from="~/change_mode"            to="$(var mode_manager_prefix)/change_mode"/>
    <param name="lifecycle_manager_service" value="/lifecycle_manager_navigation/manage_nodes"/>
    <!-- Nav2 is kept hot by lifecycle_manager autostart for now; set true to let
         the manager deactivate Nav2 on-demand in on-road mode (see MODE_MANAGER_DESIGN.md). -->
    <param name="manage_nav2_lifecycle" value="false"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
