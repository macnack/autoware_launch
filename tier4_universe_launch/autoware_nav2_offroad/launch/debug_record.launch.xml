<?xml version="1.0" encoding="UTF-8"?>
<!--
  Record the key nav2_offroad topics for offline debugging of a drive.

  Usage:
    ros2 launch autoware_nav2_offroad debug_record.launch.xml
    ros2 launch autoware_nav2_offroad debug_record.launch.xml bag_uri:=/tmp/offroad_$(date +%s)
-->
<launch>
  <arg name="bag_uri" default="$(env HOME)/offroad_debug_bag"/>
  <arg name="extra_topics" default="" description="space-separated extra topics to record"/>

  <executable
    cmd="ros2 bag record -o $(var bag_uri)
         /nav2_offroad/mode_manager/status
         /nav2_offroad/mode_manager/debug
         /nav2_offroad/mode_manager/events
         /nav2_offroad/mode_manager/markers
         /planning/trajectory
         /planning/trajectory_pre_mux
         /nav2_offroad/planning/trajectory
         /planning/offroad_goal
         /nav2_offroad/costmap/occupancy_grid
         /localization/kinematic_state
         /diagnostics
         $(var extra_topics)"
    output="screen"
    shell="true"
  />
</launch>
