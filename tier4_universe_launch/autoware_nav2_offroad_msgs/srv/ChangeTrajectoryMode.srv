# Request a trajectory mode change from trajectory_mode_manager.

# Target mode: one of autoware_nav2_offroad_msgs/TrajectoryModeState MODE_* values
# (e.g. "AW_PLANNING", "NAV2_OFFROAD").
string target_mode

# Bypass the continuity guards (position/heading/velocity). Use with caution;
# intended for stationary or test use only.
bool force
---
# True if the request was accepted (a transition was started or already in mode).
bool accepted

# Mode the manager is in after handling the request.
string current_mode

# Human-readable detail (reason for rejection, or confirmation).
string message
